# Local values for `supabase functions serve --env-file supabase/functions/.env`.
# Production: `supabase secrets set NAME=value ...` (never commit real values).
PUSH_DISPATCH_SECRET=sunmedia-local-push-secret
# Only when "Enhanced push security" is enabled for the Expo project.
EXPO_ACCESS_TOKEN=
# Leave unset in production (defaults to Expo). Local tests point it at a mock.
EXPO_PUSH_URL=

# --- Meta (Facebook Login, Lead Ads webhook, Instagram insights) ---
# From Meta for Developers → your app → App settings → Basic.
META_APP_ID=
META_APP_SECRET=
# Any long random strings you generate (openssl rand -hex 32). The verify token is also typed into the
# Meta webhook settings; the sync secret must equal the Vault secret `sunmedia_meta_sync_secret`.
META_STATE_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_SYNC_SECRET=
# Admin panel origins the OAuth flow may return to (comma separated), e.g. https://admin.sunmedia.uz,http://localhost:3000
META_ALLOWED_RETURN_ORIGINS=http://localhost:3000
# Optional: Graph API version (default v23.0) and the public functions URL when testing through a tunnel.
META_GRAPH_VERSION=
PUBLIC_FUNCTIONS_URL=
