{
  "name": "sunmedia-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/dev-check.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/build-check.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "supabase": "supabase",
    "db:start": "supabase start -x logflare,vector,supavisor,imgproxy,mailpit",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --local --schema public > types/database.ts && cp types/database.ts '../SUNMEDIA USER/types/database.ts'",
    "test": "node --test 'tests/*.test.mjs'",
    "test:unit": "node --test 'supabase/functions/**/*.test.ts'"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.57.4",
    "lenis": "^1.3.26",
    "motion": "^14.1.0",
    "next": "^15.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.3",
    "postcss": "^8.5.28",
    "supabase": "2.117.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
