# Brauzerda ishlatishga ruxsat etilgan public qiymatlar
NEXT_PUBLIC_SUPABASE_URL=
# Legacy anon JWT yoki yangi sb_publishable_ kalitidan bittasi
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Admin panelning ochiq manzili (OAuth qaytish manzili uchun), masalan https://admin.sunmedia.uz
NEXT_PUBLIC_SITE_URL=

# FAQAT server-side. NEXT_PUBLIC_ prefiksisiz qoldiring va Git'ga qo‘shmang.
# Legacy service_role JWT yoki yangi sb_secret_ kalitidan bittasi
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
