# Brauzerda ishlatishga ruxsat etilgan public qiymatlar
NEXT_PUBLIC_SUPABASE_URL=
# Legacy anon JWT yoki yangi sb_publishable_ kalitidan bittasi
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Admin panelning ochiq manzili (OAuth qaytish manzili uchun), masalan https://admin.sunmedia.uz
NEXT_PUBLIC_SITE_URL=

# FAQAT server-side. NEXT_PUBLIC_ prefiksisiz qoldiring va Git'ga qo‘shmang.
# Legacy service_role JWT yoki yangi sb_secret_ kalitidan bittasi
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# FAQAT server-side: "Mijoz tahlili" AI (Claude). Bo'sh bo'lsa sahifada "AI ulanmagan" yoziladi.
ANTHROPIC_API_KEY=
# Ixtiyoriy, standart: claude-sonnet-5-5
AI_MODEL=

# FAQAT server-side: "Sunny" AI yordamchi (saytda va ilovada). ANTHROPIC_API_KEY ni ishlatadi.
# Ixtiyoriy model (standart: AI_MODEL yoki claude-sonnet-5-5)
ASSISTANT_MODEL=
# BEPUL variant (karta kerak emas): aistudio.google.com -> Get API key. ANTHROPIC_API_KEY bo'lmasa robot shu bilan
# gapiradi (gemini-3.5-flash-lite, eng tezi; ASSISTANT_GEMINI_MODEL bilan boshqasini birinchi qo'yish mumkin), ovoz
# (gemini-3.8-flash-lite-tts, ovoz: ASSISTANT_GEMINI_VOICE=Puck) va Safari/iPhone'da o'zbekcha nutqni tanish ham shundan.
# Diqqat: bepul TTS limiti kuniga ~10 so'rov — doimiy o'zbekcha ovoz uchun Azure (pastda) tavsiya etiladi.
GEMINI_API_KEY=
# Ovoz: Azure Speech (pullik/karta bilan, ixtiyoriy) (o'zbekcha neyron ovoz uz-UZ-SardorNeural / uz-UZ-MadinaNeural). Bo'sh bo'lsa brauzer ovozi ishlatiladi.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ASSISTANT_VOICE=uz-UZ-SardorNeural
# Expo web build kabi boshqa domenlardan chaqirish uchun (vergul bilan), masalan https://app.sunmedia.uz
ASSISTANT_ALLOWED_ORIGINS=
